<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Properties>
        <!-- Creates a unique timestamp for the overall execution run (Format: yyyyMMdd_HHmmss) -->
        <Property name="runTimestamp">${date:yyyyMMdd_HHmm}</Property>
    </Properties>

    <Appenders>
        <Console name="ConsoleAppender" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm} [%t] %-5level %logger{1} - %msg%n"/>
        </Console>

        <Routing name="RoutingAppender">
            <Routes pattern="$${ctx:logFileName}">
                <!-- Fallback file saved inside a timestamped execution folder -->
                <Route key="$${ctx:logFileName}">
                    <File name="DefaultLogFile" fileName="target/automation-logs/Run_${runTimestamp}/suite-execution.log">
                        <PatternLayout pattern="%d{yyyy-MM-dd HH:mm} [%t] %-5level - %msg%n"/>
                    </File>
                </Route>
                <!-- Test files saved inside the exact same timestamped execution folder -->
                <Route>
                    <File name="TestLogFile-${ctx:logFileName}" fileName="target/automation-logs/Run_${runTimestamp}/${ctx:logFileName}.log">
                        <PatternLayout pattern="%d{yyyy-MM-dd HH:mm} [%t] %-5level - %msg%n"/>
                    </File>
                </Route>
            </Routes>
        </Routing>
    </Appenders>

    <Loggers>
        <Root level="INFO">
            <AppenderRef ref="ConsoleAppender" />
            <AppenderRef ref="RoutingAppender" />
        </Root>
    </Loggers>
</Configuration>